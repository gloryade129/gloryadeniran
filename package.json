{
  "name": "gods-virtue-worker",
  "version": "1.0.0",
  "description": "Persistent WhatsApp AI Assistant & Group Moderation Worker with Anti-Ban Human Simulation",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "test": "node --test test/*.test.mjs",
    "train": "npm run train:parse && npm run train:profile",
    "train:parse": "py -3 tools/wa_export/parse_whatsapp.py --input src/data/chat_export.txt --me \"You\" --out src/data/parsed_chat.jsonl",
    "train:profile": "py -3 tools/wa_export/style_profile.py --input src/data/parsed_chat.jsonl --out-dir src/data",
    "train:harvest": "node tools/wa_export/harvest_from_device.mjs --chats 8 --screens 60 --out src/data/harvest.jsonl",
    "train:merge": "py -3 tools/wa_export/style_profile.py --inputs src/data/parsed_chat.jsonl src/data/harvest.jsonl --out-dir src/data",
    "train:decrypt": "py -3 tools/wa_export/decrypt_crypt14.py",
    "test:decrypt": "py -3 tools/wa_export/test_decrypt_roundtrip.py",
    "voice:check": "node tools/voice-report.mjs",
    "policy:check": "node tools/policy-report.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@supabase/supabase-js": "^2.49.1",
    "@whiskeysockets/baileys": "^6.7.13",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0"
  }
}
