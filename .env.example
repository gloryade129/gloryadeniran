# God's Virtue Persistent Worker Environment Variables

# 1. Supabase Cloud Database (Required for sync with Dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. AI Providers — the router tries Groq → Gemini → Cloudflare, then fails over
#    automatically. Configure as many as you like; one is enough to run. With all
#    three on free tiers the bot no longer lives or dies by Gemini's 20/day cap.

# 2a. Groq (recommended primary). Free, no card: generous daily quota + Whisper
#     speech-to-text for voice notes. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# 2b. Google Gemini (best vision + native audio). Get a key at:
#     https://aistudio.google.com/
# NOTE: the free tier caps requests PER DAY PER MODEL (as low as ~20) and does not
# include Search grounding. Enable billing for a dependable daily quota.
GEMINI_API_KEY=

# 2c. Cloudflare Workers AI (final backstop: text, vision, Whisper, TTS, FLUX).
#     Account ID: Cloudflare dashboard → Workers & Pages → Account ID.
#     Token needs the "Workers AI: Read" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional model overrides
CLOUDFLARE_TTS_MODEL=@cf/myshell-ai/melotts
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Media features (Cloudflare required). Set to 'false' to disable.
# Voice replies: a member's voice note gets a spoken reply when TTS succeeds,
# otherwise the bot falls back to text.
VOICE_REPLIES_ENABLED=true
# Owner-only `.imagine` image generation.
IMAGE_GENERATION_ENABLED=true

# Google Search grounding. Not available on the free tier — set to false on the free
# plan to avoid a wasted request per reply. Defaults to true (on); the worker also
# self-disables it if grounded calls keep failing.
ENABLE_SEARCH_GROUNDING=true

# 3. Next.js Dashboard Endpoint (Optional, for direct webhook sync)
DASHBOARD_API_URL=https://gloryadeniran.cv/api/gods-virtue

# 4. Local Session Store Directory
SESSION_DIR=./session_auth

# 5. Admin Access (WhatsApp DM dot-commands: .help, .lock, .pause, .vcf ...)
# Phone numbers authorized automatically on boot, comma separated, digits only.
ADMIN_PHONE=
OWNER_PHONE=

# PIN accepted by the ".claim <PIN>" command.
# If left unset, a random 8-character PIN is generated on every boot and printed to the
# worker logs. (The historical default "1290" was public in this repo, so it is rejected.)
ADMIN_PIN=

# Protects the diagnostic HTTP endpoints: GET /diag, /models and /test-ai.
# In production these fail closed until this is set. Send it as the
# `x-diag-token` header (the dashboard diagnostics proxy does this for you).
ADMIN_DIAG_TOKEN=

# 5b. Smart moderation 2.0 thresholds (conservative defaults shown)
MODERATION_FLOOD_MESSAGES=8
MODERATION_FLOOD_WINDOW_SECONDS=20
MODERATION_DUPLICATE_COUNT=4
MODERATION_DUPLICATE_WINDOW_SECONDS=60
MODERATION_MENTION_LIMIT=8
MODERATION_RAID_JOINS=10
MODERATION_RAID_WINDOW_SECONDS=120
# Opt-in: lock the group automatically when a join raid is detected.
MODERATION_AUTO_LOCK_ON_RAID=false

# 6. HTTP port for the built-in health-check server (defaults to 8080)
PORT=8080

# 7. Conversation Starter (silence breaker) — optional tuning
# Global kill switch: set to 'off' to silence the feature everywhere
# (per-group control lives on the dashboard: "Conversation Starter" toggle).
SILENCE_ENGAGEMENT=on
# Minutes of group silence before a grounded nudge is posted (default 60)
SILENCE_MINUTES=60
# Minimum minutes between two nudges in the same group (default 90)
SILENCE_NUDGE_COOLDOWN_MIN=90

# 8. Self-improvement — set to 'off' to disable the daily 03:30 self-review
# (the bot stops writing itself new style rules; existing ones stay active)
SELF_IMPROVEMENT=on
