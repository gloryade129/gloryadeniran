# God's Virtue Persistent Worker Environment Variables

# 1. Supabase Cloud Database (Required for sync with Dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google Gemini API Key (Required for AI conversational brain)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# 3. Next.js Dashboard Endpoint (Optional, for direct webhook sync)
DASHBOARD_API_URL=https://gloryadeniran.cv/api/gods-virtue

# 4. Local Session Store Directory
SESSION_DIR=./session_auth

# 5. Admin Access (WhatsApp DM dot-commands: .help, .lock, .pause, .vcf ...)
# Phone numbers authorized automatically on boot, comma separated, digits only.
ADMIN_PHONE=
OWNER_PHONE=

# PIN accepted by the ".claim <PIN>" command.
# If left unset, a random 8-character PIN is generated on every boot and printed to the
# worker logs. (The historical default "1290" was public in this repo, so it is rejected.)
ADMIN_PIN=

# 6. HTTP port for the built-in health-check server (defaults to 8080)
PORT=8080
